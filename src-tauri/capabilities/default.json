{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$LOCALDATA/**" },
        { "path": "$APPDATA/**" }
      ]
    },
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }] }
  ]
}

# Copy to .env and fill in. Never commit the real .env.
# Admin API bearer token, at least 32 chars: openssl rand -hex 32
# Leave empty to disable the HTTP admin API (the CLI still works).
COSMETICS_ADMIN_TOKEN=
# approval (default): custom capes hidden until approved. instant: shown right away.
COSMETICS_CAPE_MODERATION=approval
# Set to 1 only when a reverse proxy you control sets X-Forwarded-For.
COSMETICS_TRUST_PROXY=1
# Browser origins allowed to call the API. The launcher and mod do not need CORS.
COSMETICS_CORS_ORIGINS=
# Requests per minute per IP for normal API calls.
COSMETICS_RATE_PER_MINUTE=120
# Session token lifetime in seconds (300-86400).
COSMETICS_TOKEN_TTL_SECS=3600
